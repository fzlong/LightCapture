# This folder also contains private local builds and capture diagnostics.
# Only the explicitly listed source/configuration directories belong in Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/Build-OBS.ps1
!/Setup-Dependencies.ps1
!/src/
!/tests/
!/capture-tests/
!/gif-tests/
!/startup-tests/
!/third-party-notices/
!/.github/
!/tools/

**/bin/
**/obj/
**/.vs/
**/*.user
**/*.suo
**/*.exe
**/*.dll
**/*.pdb
**/*.mp4
**/*.mkv
**/*.ts
**/*.gif
**/*.png
**/*.csv
**/*.log
**/validation*/
**/self-test*.json
**/settings.json
/tools/*
!/tools/README.md
